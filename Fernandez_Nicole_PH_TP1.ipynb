```python
# ============================================================
# TP1 - PROCESAMIENTO DEL HABLA: WEBSCRAPPING
# Alumna: Nicole Fernandez
# ============================================================

# ============================================================
# 1. WEBSCRAPPING
# ============================================================

import requests
from bs4 import BeautifulSoup

# URL de la página seleccionada
url = "https://seul.ar/video/52-sebastian-campanario/"

# Realizamos una solicitud HTTP a la página
respuesta = requests.get(url)

# Mostramos el código de respuesta
print("Código de respuesta:", respuesta.status_code)

# Analizamos el contenido HTML de la página
soup = BeautifulSoup(respuesta.text, "html.parser")

# Extraemos los párrafos de la página
parrafos = soup.find_all("p")

# Unimos los párrafos para obtener un único texto
texto = "\n".join(
    parrafo.get_text(" ", strip=True)
    for parrafo in parrafos
)

# Mostramos una parte del texto obtenido
print(texto[:5000])

# Cantidad de caracteres obtenidos
print("\nCantidad de caracteres:", len(texto))


# ============================================================
# 2. PREPROCESAMIENTO
# ============================================================

# ------------------------------------------------------------
# 2.1 Muestra las stop words que tenga tu texto
# ------------------------------------------------------------

import nltk

# Descargamos las stop words
nltk.download("stopwords")

from nltk.corpus import stopwords

# Obtenemos las stop words en español
stop_words = set(stopwords.words("spanish"))

# Mostramos la cantidad de stop words
print("\nCantidad de stop words:", len(stop_words))

# Mostramos las stop words
print(stop_words)


# ------------------------------------------------------------
# 2.2 Quita las stop-words y caracteres extraños
# ------------------------------------------------------------

import re

# Convertimos todo el texto a minúsculas
texto_limpio = texto.lower()

# Eliminamos caracteres especiales y números
texto_limpio = re.sub(
    r"[^a-záéíóúüñ\s]",
    " ",
    texto_limpio
)

# Separamos el texto en palabras
palabras = texto_limpio.split()

# Eliminamos las stop words
palabras_filtradas = [
    palabra
    for palabra in palabras
    if palabra not in stop_words
]

# Volvemos a unir las palabras
texto_sin_stopwords = " ".join(palabras_filtradas)

# Mostramos una parte del texto procesado
print("\nTexto sin stop words:")
print(texto_sin_stopwords[:5000])


# ------------------------------------------------------------
# Nube de palabras
# ------------------------------------------------------------

!pip install wordcloud

from wordcloud import WordCloud
import matplotlib.pyplot as plt

# Generamos la nube de palabras
wordcloud = WordCloud(
    width=1200,
    height=600,
    background_color="white",
    collocations=False
).generate(texto_sin_stopwords)

# Mostramos la nube de palabras
plt.figure(figsize=(15, 7))
plt.imshow(wordcloud, interpolation="bilinear")
plt.axis("off")
plt.show()


# ============================================================
# 2.3 Usando el texto conseguido en el punto 1
# ============================================================

# ------------------------------------------------------------
# 2.3.1 Limpieza, oraciones y matriz documento-vocabulario
# ------------------------------------------------------------

# Descargamos los recursos necesarios de NLTK
nltk.download("punkt")
nltk.download("punkt_tab")

from nltk.tokenize import sent_tokenize
from sklearn.feature_extraction.text import CountVectorizer

# Dividimos el texto en oraciones
oraciones = sent_tokenize(
    texto,
    language="spanish"
)

print("\nCantidad de oraciones:", len(oraciones))

# Mostramos las primeras 10 oraciones
print("\nPrimeras oraciones:")
for i, oracion in enumerate(oraciones[:10]):
    print(i + 1, oracion)

# Creamos el vectorizador
vectorizador = CountVectorizer(
    stop_words=list(stop_words)
)

# Construimos la matriz documento-vocabulario
matriz_documento_vocabulario = vectorizador.fit_transform(
    oraciones
)

# Mostramos las dimensiones de la matriz
print(
    "\nDimensiones de la matriz documento-vocabulario:",
    matriz_documento_vocabulario.shape
)

# Convertimos la matriz en un DataFrame
import pandas as pd

df_matriz = pd.DataFrame(
    matriz_documento_vocabulario.toarray(),
    columns=vectorizador.get_feature_names_out()
)

# Mostramos las primeras filas
print("\nMatriz documento-vocabulario:")
display(df_matriz.head())


# ------------------------------------------------------------
# 2.3.2 Determina la longitud de tu vocabulario
# ------------------------------------------------------------

# Obtenemos el vocabulario
vocabulario = vectorizador.get_feature_names_out()

# Calculamos su longitud
longitud_vocabulario = len(vocabulario)

print(
    "\nLongitud del vocabulario:",
    longitud_vocabulario
)

# Mostramos algunos términos del vocabulario
print("\nPrimeros términos del vocabulario:")
print(vocabulario[:100])


# ------------------------------------------------------------
# 2.3.3 Aplica TF-IDF a tu matriz documento-vocabulario
# ------------------------------------------------------------

from sklearn.feature_extraction.text import TfidfVectorizer

# Creamos el vectorizador TF-IDF
tfidf_vectorizador = TfidfVectorizer(
    stop_words=list(stop_words)
)

# Aplicamos TF-IDF a las oraciones
matriz_tfidf = tfidf_vectorizador.fit_transform(
    oraciones
)

# Mostramos las dimensiones de la matriz
print(
    "\nDimensiones de la matriz TF-IDF:",
    matriz_tfidf.shape
)

# Convertimos la matriz TF-IDF en un DataFrame
df_tfidf = pd.DataFrame(
    matriz_tfidf.toarray(),
    columns=tfidf_vectorizador.get_feature_names_out()
)

# Mostramos las primeras filas
print("\nMatriz TF-IDF:")
display(df_tfidf.head())


# ------------------------------------------------------------
# Palabras con mayor valor TF-IDF
# ------------------------------------------------------------

import numpy as np

# Sumamos los valores TF-IDF de cada palabra
importancias = np.asarray(
    matriz_tfidf.sum(axis=0)
).flatten()

# Creamos un DataFrame
df_importancias = pd.DataFrame({
    "palabra": tfidf_vectorizador.get_feature_names_out(),
    "tfidf_total": importancias
})

# Ordenamos de mayor a menor
df_importancias = df_importancias.sort_values(
    by="tfidf_total",
    ascending=False
)

# Mostramos las 20 palabras con mayor valor
print("\n20 palabras con mayor valor TF-IDF:")
display(df_importancias.head(20))


# ============================================================
# CONCLUSIONES
# ============================================================

print("""
CONCLUSIONES

En este trabajo se realizó el procesamiento de un texto en español
obtenido mediante webscrapping. Para obtener la información se utilizó
una página web que contiene una entrevista a Sebastián Campanario.

En primer lugar, se utilizó la biblioteca requests para realizar una
solicitud a la página web y BeautifulSoup para analizar el contenido
HTML y extraer el texto.

Posteriormente se realizó un proceso de preprocesamiento. Se
convirtieron las palabras a minúsculas, se eliminaron caracteres
especiales y se quitaron las stop words correspondientes al idioma
español.

A partir del texto procesado se generó una nube de palabras utilizando
la biblioteca WordCloud. Esta representación permite observar
visualmente los términos que aparecen con mayor frecuencia en el texto.

Luego se dividió el texto en oraciones y se construyó una matriz
documento-vocabulario utilizando CountVectorizer. En esta matriz, las
filas representan los documentos u oraciones y las columnas representan
las palabras pertenecientes al vocabulario.

Finalmente se aplicó TF-IDF para obtener una representación numérica de
la importancia de los términos dentro de cada documento. Los valores
obtenidos permiten identificar palabras que tienen mayor relevancia
relativa dentro de determinadas oraciones.

El trabajo permitió aplicar diferentes etapas del procesamiento del
lenguaje natural, desde la obtención de información mediante
webscrapping hasta el preprocesamiento, la representación del texto y
el análisis mediante TF-IDF.
""")
